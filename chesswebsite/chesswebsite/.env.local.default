# Local environment file for ChessWebsite
# This file is intentionally NOT gitignored so you can keep a local copy of main settings.

# Django secret key (replace with a secure value)
SECRET_KEY=replace-me-with-a-secure-secret

# Debug mode
DEBUG=True

# Allowed hosts (comma separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres settings (used when DATABASE_URL is not provided)
USE_SQLITE=True

# Stockfish binary path (set to your local binary)
STOCKFISH_PATH="Your path here"
